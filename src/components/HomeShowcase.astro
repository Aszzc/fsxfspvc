---
interface Props { locale?: 'zh' | 'en' }
const { locale = 'zh' } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const products = [
  { slug: 'insulation-70', image: 'pellets-white.jpg', zh: 'PVC 绝缘料', en: 'PVC insulation compound', descZh: '用于电线导体绝缘层，按用途和目标标准选择。', descEn: 'For wire insulation, selected to suit the application and target standard.' },
  { slug: 'sheath', image: 'pellets-amber.jpg', zh: 'PVC 护套料', en: 'PVC sheath compound', descZh: '面向电源线、控制线等线缆外护套。', descEn: 'For outer jackets on power cords, control cables and more.' },
  { slug: 'electronic', image: 'pellets-blue.jpg', zh: '电子线料', en: 'Electronic wire compound', descZh: '面向电子连接线与小规格线材加工。', descEn: 'For electronic leads and small-gauge wire processing.' },
  { slug: 'plug', image: 'pellets-red.jpg', zh: '插头注塑料', en: 'Plug molding compound', descZh: '用于电源插头、线尾护套等注塑成型。', descEn: 'For injection molded plugs and strain reliefs.' },
  { slug: 'heat-resistant-105', image: 'pellets-brown.jpg', zh: '105℃ 耐高温料', en: '105°C heat-resistant compound', descZh: '面向耐温要求较高的绝缘与护套应用。', descEn: 'For insulation and sheathing with elevated temperature requirements.' },
  { slug: 'cold-resistant', image: 'pellets-green.jpg', zh: '耐寒 PVC 料', en: 'Cold-resistant PVC compound', descZh: '面向低温使用环境的线缆材料。', descEn: 'Cable compounds for low-temperature applications.' },
  { slug: 'transparent', image: 'pellets-clear.jpg', zh: '透明 PVC 料', en: 'Transparent PVC compound', descZh: '用于透明线材及其他透明软制品。', descEn: 'For transparent wire and other flexible products.' },
  { slug: 'modified', image: 'pellets-yellow.jpg', zh: '改性 PVC 定制料', en: 'Custom modified PVC compound', descZh: '按用途与加工需求沟通配方及试样。', descEn: 'Discuss formulations and samples for your application and process.' },
];
const applications = [
  { image: 'flat-wire-white.jpg', zh: '电线电缆', en: 'Wire & cable', descZh: '绝缘与护套材料', descEn: 'Insulation and sheathing', slug: 'insulation-70' },
  { image: 'appliance-cable.jpg', zh: '家电与电子线材', en: 'Appliance & electronic wire', descZh: '内部配线与连接线', descEn: 'Internal and connecting wire', slug: 'electronic' },
  { image: 'plug-cord.jpg', zh: '电源线与插头', en: 'Power cords & plugs', descZh: '线缆护套与注塑包胶', descEn: 'Cable jackets and molded ends', slug: 'plug' },
  { image: 'corrugated-tube-gray.jpg', zh: '软管与异型材', en: 'Tubing & profiles', descZh: '挤出制品与定制应用', descEn: 'Extruded and custom applications', slug: 'modified' },
];
---
<section class="home-hero">
  <img src="/images/factory-pelletizing-workshop.jpg" alt={en ? 'Pelletizing equipment in the factory workshop' : '工厂车间造粒设备'} fetchpriority="high" />
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <p class="eyebrow">XIANGFA SHUN · PVC COMPOUNDS</p>
    <h1>{en ? 'PVC compounds for the products you make' : <>从一颗胶粒，<br class="hero-break" />到可靠的线缆应用</>}</h1>
    <p class="hero-lead">{en ? 'Explore PVC compounds for wire insulation, cable sheathing, electronic wire and plug molding. Discuss your application and processing needs with our Foshan team.' : '专注 PVC 电线电缆料，提供绝缘料、护套料、电子线料及插头料，结合应用与加工需求沟通选料和试样。'}</p>
    <div class="hero-actions"><a class="btn btn-phone btn-lg" href="#products">{en ? 'Explore products' : '探索产品'} <span aria-hidden="true">↗</span></a><a class="hero-link" href="#applications">{en ? 'Explore applications' : '了解行业应用'} <span aria-hidden="true">↓</span></a></div>
  </div>
</section>
<section class="home-section products" id="products">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">OUR PRODUCTS / 01</p><h2>{en ? 'Find the right compound' : '以应用为起点，选择合适的材料'}</h2><p>{en ? 'From insulation to molding, explore our core PVC compound range.' : '从线缆绝缘到插头成型，探索湘发顺的 PVC 材料系列。'}</p></div><div class="product-heading-actions"><a class="text-link" href={`${prefix}/products/`}>{en ? 'All products' : '查看全部产品'} <span aria-hidden="true">↗</span></a></div></div>
    <div class="carousel-wrap">
    <div class="product-grid" id="product-carousel" aria-label={en ? 'Product categories' : '产品分类'}>{products.map((p, i) => <a class="product-tile" href={`${prefix}/products/${p.slug}/`}><div class="product-image"><img src={`/images/products/${p.image}`} alt={en ? 'PVC pellet sample' : 'PVC 胶粒样品'} loading="lazy" /><span>0{i + 1}</span></div><div class="product-info"><div><small>PVC COMPOUND</small><h3>{en ? p.en : p.zh}</h3><p>{en ? p.descEn : p.descZh}</p></div><span class="arrow" aria-hidden="true">↗</span></div></a>)}</div>
    <div class="carousel-controls" hidden><button type="button" class="carousel-prev" aria-label={en ? 'Previous product' : '查看上一个产品'} aria-controls="product-carousel">←</button><button type="button" class="carousel-next" aria-label={en ? 'Next product' : '查看下一个产品'} aria-controls="product-carousel">→</button></div>
    </div>
  </div>
</section>
<section class="home-section applications" id="applications">
  <div class="container"><div class="section-heading"><div><p class="eyebrow">APPLICATIONS / 02</p><h2>{en ? 'Materials made for real applications' : '材料，融入每一种应用'}</h2><p>{en ? 'Explore potential applications and discuss the right material for your process.' : '围绕不同制品与加工方式，寻找适合的材料方向。'}</p></div></div>
    <div class="application-grid">{applications.map((a, i) => <a class="application-tile" href={`${prefix}/products/${a.slug}/`}><img src={`/images/products/${a.image}`} alt={en ? `${a.en} sample` : `${a.zh}样品`} loading="lazy" /><div class="app-shade"></div><div class="app-copy"><span>0{i + 1} / APPLICATION</span><h3>{en ? a.en : a.zh}</h3><p>{en ? a.descEn : a.descZh}</p></div><span class="app-arrow" aria-hidden="true">↗</span></a>)}</div>
    <p class="caption">{en ? 'Finished-product samples illustrate possible applications; suitability should be confirmed for each project.' : '下游制品样品用于展示应用方向，具体适用性需结合项目确认。'}</p>
  </div>
</section>
<section class="about-home"><div class="about-image"><img src="/images/factory-exterior-building.jpg" alt={en ? 'Xiangfa Shun factory exterior' : '湘发顺工厂外景'} loading="lazy" /></div><div class="about-copy"><p class="eyebrow">ABOUT XIANGFA SHUN / 03</p><h2>{en ? 'A manufacturing partner in Foshan' : '立足佛山，以材料连接制造'}</h2><p>{en ? 'Foshan Sanshui Xiangfa Shun Plastic Co., Ltd. supplies PVC wire and cable compounds. From application discussion to sample evaluation, we work with customers to identify a suitable direction.' : '佛山市三水湘发顺塑料有限公司提供 PVC 电线电缆料及改性配方。从用途沟通到样品验证，我们与客户一起寻找适合生产需求的材料方向。'}</p><a class="text-link light-link" href={`${prefix}/about/`}>{en ? 'About our company' : '了解湘发顺'} <span aria-hidden="true">↗</span></a></div></section>
<section class="home-cta"><div class="container cta-inner"><div><p class="eyebrow">LET’S TALK</p><h2>{en ? 'Tell us what you are making.' : '从您的产品需求开始。'}</h2><p>{en ? 'Share your application, specifications and processing requirements for a sample or quotation.' : '告诉我们用途、规格与加工要求，沟通选料、试样或报价。'}</p></div><a class="btn btn-phone btn-lg" href={`${prefix}/tools/inquiry/`}>{en ? 'Send an inquiry' : '开始询价'} <span aria-hidden="true">↗</span></a></div></section>
<style>
