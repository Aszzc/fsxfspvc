lor:#a15c38;letter-spacing:.12em;font-weight:800}.product-info h3{font-size:21px;margin:8px 0;color:#123b32}.product-info p{font-size:14px;line-height:1.6;color:#68756e;margin:0}.arrow{font-size:24px;color:#c46331}.caption{font-size:12px;color:#78847d;margin:25px 0 0}.application-tile{position:relative;min-height:340px;overflow:hidden;color:#fff;background:#163a32}.application-tile img,.app-shade{position:absolute;width:100%;height:100%;inset:0;object-fit:cover;transition:transform .4s}.app-shade{background:linear-gradient(0deg,rgba(4,25,21,.92),rgba(4,25,21,.04) 80%)}.app-copy{position:absolute;bottom:25px;left:23px;right:20px}.app-copy span{font-size:10px;letter-spacing:.15em;color:#f6b38a}.app-copy h3{font-size:22px;color:#fff;margin:10px 0 5px}.app-copy p{font-size:14px;color:#ffffffc9;margin:0}.app-arrow{position:absolute;top:18px;right:20px;color:white;font-size:23px}.about-home{display:grid;grid-template-columns:1fr 1fr;background:#103b32;color:white}.about-image{min-height:420px}.about-image img{width:100%;height:100%;object-fit:cover}.about-copy{padding:clamp(45px,7vw,100px);align-self:center}.about-copy h2{color:#fff}.about-copy>p:not(.eyebrow){color:#d5e0d9;max-width:500px;line-height:1.9;margin-bottom:28px}.light-link{color:#fff}.home-cta{background:#f8f8f5;padding:70px 0}.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:30px}.home-cta h2{margin-bottom:10px}.home-cta p:not(.eyebrow){margin:0;color:#68756e}@media(max-width:850px){.product-grid,.application-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.home-section{padding:65px 0}.application-tile{min-height:300px}.about-home{grid-template-columns:1fr}.about-image{min-height:300px;max-height:400px}.about-copy{padding:50px 24px}}@media(max-width:560px){.home-hero{min-height:520px;height:auto}.hero-content{padding-top:70px;padding-bottom:90px}.home-hero h1{font-size:38px}.hero-lead{font-size:16px}.hero-actions{gap:18px;flex-wrap:wrap}.section-heading{align-items:start;flex-direction:column}.product-grid,.application-grid{gap:12px}.product-info h3{font-size:17px}.product-info p{font-size:13px}.application-tile{min-height:240px}.app-copy{left:14px;bottom:15px}.app-copy h3{font-size:18px}.app-copy p{font-size:12px}.cta-inner{align-items:start;flex-direction:column}}

/* Brighter, softer presentation with the product imagery in focus. */
.home-hero { height: min(570px, 68vh); min-height: 470px; }
.hero-overlay { background: linear-gradient(90deg, rgba(9, 47, 39, .88), rgba(13, 57, 46, .58) 50%, rgba(16, 56, 45, .08)); }
.hero-actions .btn { box-shadow: 0 10px 24px rgba(107, 49, 20, .24); }
.hero-link { transition: color .2s ease, transform .2s ease; }
.hero-link:hover, .hero-link:focus-visible { transform: translateY(-2px); }
.products { background: #fffdf9; }
.applications { background: linear-gradient(145deg, #eef6ec, #f8f7ee); }
.product-grid, .application-grid { gap: 22px; }
.product-tile { overflow: hidden; border-radius: 22px; background: #fff; box-shadow: 0 8px 28px rgba(29, 70, 51, .09); border: 1px solid #edf1e8; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
.product-tile:hover, .product-tile:focus-visible { transform: translateY(-6px); border-color: #c4ddcb; box-shadow: 0 18px 38px rgba(29, 70, 51, .16); }
.product-image { background: #f1f5ee; }
.product-image img, .application-tile img { transition: transform .45s ease; }
.product-tile:focus-visible img, .application-tile:focus-visible img { transform: scale(1.04); }
.product-image > span { border-radius: 999px; box-shadow: 0 4px 12px #163a3214; }
.product-info { padding: 20px 20px 24px; }
.product-info .arrow, .app-arrow { transition: transform .25s ease, background .25s ease; }
.product-tile:hover .arrow, .product-tile:focus-visible .arrow, .application-tile:hover .app-arrow, .application-tile:focus-visible .app-arrow { transform: translate(4px, -4px); }
.application-tile { border-radius: 22px; box-shadow: 0 10px 28px rgba(29, 70, 51, .13); transition: transform .25s ease, box-shadow .25s ease; }
.application-tile:hover, .application-tile:focus-visible { transform: translateY(-5px); box-shadow: 0 18px 36px rgba(29, 70, 51, .22); }
.app-shade { background: linear-gradient(0deg, rgba(4, 33, 25, .94), rgba(4, 33, 25, .32) 50%, rgba(4, 33, 25, .06)); }
.app-arrow { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: rgba(255, 255, 255, .2); }
.about-home { background: #164d40; }
.about-image { overflow: hidden; }
.about-image img { transition: transform .5s ease; }
.about-home:hover .about-image img { transform: scale(1.025); }
.home-cta { background: #fff9ef; }
.cta-inner { border-radius: 26px; padding-top: 38px; padding-bottom: 38px; background: #f5e9d7; }
#products, #applications { scroll-margin-top: 150px; }
@media (max-width: 850px) { .product-grid, .application-grid { gap: 16px; } }
@media (max-width: 560px) {
  .home-hero { min-height: 440px; height: auto; }
  .hero-content { padding-top: 56px; padding-bottom: 76px; }
  .product-grid, .application-grid { gap: 12px; }
  .product-tile, .application-tile { border-radius: 16px; }
  .product-info { padding: 14px 12px 18px; }
  .app-arrow { width: 32px; height: 32px; font-size: 18px; }
  .cta-inner { width: calc(100% - 32px); padding: 28px 22px; }
  #products, #applications { scroll-margin-top: 140px; }
}
@media (prefers-reduced-motion: reduce) {
  .product-tile, .product-image img, .application-tile, .application-tile img, .product-info .arrow, .app-arrow, .about-image img, .hero-link { transition: none; }
  .product-tile:hover, .product-tile:focus-visible, .application-tile:hover, .application-tile:focus-visible, .hero-link:hover, .hero-link:focus-visible { transform: none; }
  .product-tile:hover img, .product-tile:focus-visible img, .application-tile:hover img, .application-tile:focus-visible img, .about-home:hover .about-image img, .product-tile:hover .arrow, .product-tile:focus-visible .arrow, .application-tile:hover .app-arrow, .application-tile:focus-visible .app-arrow { transform: none; }
}

/* Home adopts the same mineral teal and warm coral used throughout the site. */
.home-hero { background: #123f4c; }
.hero-overlay { background: linear-gradient(90deg, rgba(10, 45, 55, .91), rgba(14, 69, 72, .65) 52%, rgba(15, 73, 72, .12)); }
.hero-content .eyebrow { color: #ffd3b5; }
.eyebrow { color: #b8472d; }
.section-heading h2, .about-copy h2, .home-cta h2, .product-info h3 { color: var(--color-primary-dark); }
.products { background: #fffdfa; }
.applications { background: linear-gradient(135deg, #e8f5f2, #f7f8ed); }
.product-tile { border-color: #e2ece8; box-shadow: 0 8px 28px rgba(20, 72, 72, .09); }
.product-tile:hover, .product-tile:focus-visible { border-color: #a8d2c8; box-shadow: 0 18px 38px rgba(20, 72, 72, .16); }
