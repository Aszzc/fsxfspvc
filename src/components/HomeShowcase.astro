.about-copy h2 { color: #fff; }
.about-copy>p:not(.eyebrow) { color: #e1efeb; }
.about-copy .eyebrow { color: #ffd1b0; }
.home-cta { background: #fffaf2; }
.cta-inner { background: linear-gradient(120deg, #ffefdf, #f3f4dd); }

@media (max-width: 560px) {
  :global(html[lang="en"]) .home-hero h1 { font-size: clamp(30px, 8vw, 38px); line-height: 1.12; }
  :global(html[lang="en"]) .hero-lead { font-size: 15px; line-height: 1.65; }
}

@media (max-width: 380px) {
  .application-grid { grid-template-columns: 1fr; }
  .application-tile { min-height: 210px; }
  .app-copy { left: 20px; bottom: 19px; }
  .app-copy h3 { font-size: 20px; }
  .app-copy p { font-size: 14px; }
}

@media (max-width: 560px) { .hero-break { display: none; } }

.product-heading-actions { display: flex; align-items: center; gap: 24px; }
.carousel-controls { display: flex; gap: 8px; }
.carousel-controls[hidden] { display: none; }
.carousel-controls button { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid #c8ded8; border-radius: 50%; background: #fff; color: var(--color-primary); font-size: 22px; cursor: pointer; transition: background .2s ease, color .2s ease; }
.carousel-controls button:hover:not(:disabled), .carousel-controls button:focus-visible { background: var(--color-primary); color: #fff; }
.carousel-controls button:disabled { opacity: .35; cursor: default; }
.product-grid { display: grid; grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: calc((100% - 66px) / 4); gap: 22px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding: 4px 2px 20px; scrollbar-width: thin; scrollbar-color: #b3ccc5 transparent; }
.product-tile { scroll-snap-align: start; min-width: 0; }
@media (max-width: 850px) { .product-grid { grid-template-columns: none; grid-auto-columns: calc((100% - 16px) / 2); gap: 16px; } }
@media (max-width: 560px) { .product-heading-actions { width: 100%; justify-content: space-between; } .product-grid { grid-template-columns: none; grid-auto-columns: 78%; gap: 12px; } }
@media (prefers-reduced-motion: reduce) { .product-grid { scroll-behavior: auto; } }

/* Overlay controls keep the gallery clean while preserving touch scrolling. */
.carousel-wrap { position: relative; }
.product-grid { scrollbar-width: none; -ms-overflow-style: none; }
.product-grid::-webkit-scrollbar { display: none; }
.carousel-controls { position: absolute; inset: 0; display: block; pointer-events: none; }
.carousel-controls[hidden] { display: none; }
.carousel-controls button { width: 60px; height: 60px; font-size: 28px; position: absolute; top: 34%; transform: translateY(-50%); z-index: 2; pointer-events: auto; background: rgba(13, 48, 54, .48); border: 1px solid rgba(255, 255, 255, .48); color: #fff; box-shadow: 0 4px 16px rgba(0, 0, 0, .14); backdrop-filter: blur(8px); }
.carousel-controls .carousel-prev { left: 12px; }
.carousel-controls .carousel-next { right: 12px; }
.carousel-controls button:hover:not(:disabled), .carousel-controls button:focus-visible { background: rgba(13, 48, 54, .82); color: #fff; }
.carousel-controls button:disabled { opacity: .35; }
@media (max-width: 560px) { .carousel-controls button { width: 52px; height: 52px; font-size: 25px; } .carousel-controls .carousel-prev { left: 8px; } .carousel-controls .carousel-next { right: 8px; } }
</style>


<script>
  const carousel = document.querySelector<HTMLElement>('#product-carousel');
  const controls = document.querySelector<HTMLElement>('.carousel-controls');
  const previous = controls?.querySelector<HTMLButtonElement>('.carousel-prev');
  const next = controls?.querySelector<HTMLButtonElement>('.carousel-next');
  if (carousel && controls && previous && next) {
    const update = () => {
      previous.disabled = carousel.scrollLeft <= 3;
      next.disabled = carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 1;
    };
    const move = (direction: number) => {
      const card = carousel.querySelector<HTMLElement>('.product-tile');
      const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0;
      if (card) carousel.scrollBy({ left: direction * (card.offsetWidth + gap), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    carousel.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    controls.hidden = false;
    update();
  }
</script>

