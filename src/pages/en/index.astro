---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ProductCard from '../../components/ProductCard.astro';
import { siteConfig } from '../../config/site';

const phoneNumber = '13450853338';

const productOverview = [
  {
    id: 'insulation-70',
    name: '70℃ Insulation Compound',
    category: 'PVC Insulation',
    icon: '⚡',
    description: 'PVC compound for wire conductor insulation. Confirm the target standard and performance with us before sampling.',
    highlights: ['70℃ category', 'Application-led selection', 'Color options to discuss'],
  },
  {
    id: 'sheath',
    name: 'Sheath Compound',
    category: 'PVC Sheath',
    icon: '◈',
    description: 'PVC compound for cable outer sheath. Good mechanical properties, abrasion and weather resistant.',
    highlights: ['High flexibility', 'Abrasion & weather resistant', 'Custom colors available'],
  },
  {
    id: 'electronic',
    name: 'Electronic Wire Compound',
    category: 'Electronic Wire',
    icon: '◇',
    description: 'PVC compound for small-gauge electronic wires, USB, signal, DC cables. Easy processing and low odor.',
    highlights: ['Low odor', 'Stable extrusion', 'High-speed extrusion ready'],
  },
  {
    id: 'plug',
    name: 'Plug Compound',
    category: 'Power Plug',
    icon: '◆',
    description: 'Rigid PVC compound for power plugs, sockets and housings. High strength, flame retardant, easy injection.',
    highlights: ['High hardness', 'Adjustable flame retardant', 'Good flowability'],
  },
  {
    id: 'heat-resistant-105',
    name: '105℃ Heat-resistant Compound',
    category: 'Heat-resistant',
    icon: '▲',
    description: 'PVC compound category for applications targeting 105℃ performance. Confirm the standard and test conditions before selection.',
    highlights: ['105℃ target category', 'Aging test conditions to confirm', 'Standard-specific development'],
  },
  {
    id: 'cold-resistant',
    name: '-40℃ Cold-resistant Compound',
    category: 'Cold-resistant',
    icon: '❄',
    description: 'PVC modified for -40℃ low temperature. Used in northern outdoor cables, agricultural machinery wiring, cold regions.',
    highlights: ['Low-temperature target to confirm', 'Flexibility requirements', 'Application-specific trial'],
  },
  {
    id: 'transparent',
    name: 'High-transparent Compound',
    category: 'Transparent',
    icon: '○',
    description: 'High light transmittance PVC compound for transparent power cords, decorative LED strip cables, visible wiring.',
    highlights: ['High transmittance', 'Anti-yellowing', 'Adjustable hardness'],
  },
  {
    id: 'frosted',
    name: 'Frosted / Matte Compound',
    category: 'Matte Finish',
    icon: '◯',
    description: 'PVC compound with matte frosted surface finish for premium power cords and decorative wires.',
    highlights: ['Matte texture', 'Fine touch', 'Fingerprint resistant'],
  },
  {
    id: 'modified',
    name: 'Modified Compound',
    category: 'Modified',
    icon: '⬡',
    description: 'PVC modified for custom hardness, flame retardancy, temperature and cold resistance based on client requirements.',
    highlights: ['Custom formulation', 'Small-batch trial', 'Sample/spec based development'],
  },
];

const advantages = [
  { icon: '①', title: 'In-house Formulation', desc: 'We develop PVC formulas ourselves based on cable structure, extrusion process and performance — not resold finished goods.' },
  { icon: '②', title: 'Foshan Local Factory', desc: 'Own factory with mixing, extrusion, pelletizing, screening and packaging in one line. Easy for customers to visit.' },
  { icon: '③', title: 'Stable Batch Supply', desc: 'Repeat orders can reference an agreed formulation and acceptance criteria. Ask which records and retained samples apply to your order.' },
  { icon: '④', title: 'Small-batch Customization', desc: 'New formulas and customers can start with small trial batches. Color, hardness, flame retardant grade adjustable.' },
  { icon: '⑤', title: 'Simple Process', desc: 'Direct phone & WeChat: usage → specs → sample → mass production. No long commercial process.' },
  { icon: '⑥', title: 'Sample-based Development', desc: 'Customer samples, drawings and performance specs all serve as inputs for development.' },
];

const processSteps = [
  { step: '01', label: 'Formula Discussion', desc: 'Requirements · tech align' },
  { step: '02', label: 'Trial Sample', desc: 'Small batch · client verify' },
  { step: '03', label: 'Material Mixing', desc: 'High-speed mix · sequence' },
  { step: '04', label: 'Extrusion Pelletizing', desc: 'Stable melting · output' },
  { step: '05', label: 'Cooling & Screening', desc: 'Uniform particle size' },
  { step: '06', label: 'Packaging & Delivery', desc: 'Batch ID · pallet-ready' },
  { step: '07', label: 'Order Records', desc: 'Testing · documents to agree' },
];

const suitableCustomers = [
  { icon: '⌬', label: 'Wire & Cable Maker' },
  { icon: '⌖', label: 'Electronic Wire Maker' },
  { icon: '⊞', label: 'Power Plug / Socket Maker' },
  { icon: '⌘', label: 'Home Appliance Maker' },
  { icon: '☷', label: 'LED Strip Maker' },
  { icon: '⊕', label: 'Premium / Decorative Wire' },
];

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://xfspvc.com/en/#website',
  url: 'https://xfspvc.com/en/',
  name: 'Foshan Sanshui Xiangfa Shun Plastic Co., Ltd.',
  inLanguage: ['en', 'zh-CN'],
  publisher: { '@id': 'https://xfspvc.com/#organization' },
};

const productListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Xiangfa Shun PVC Wire & Cable Compound List',
  itemListElement: productOverview.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://xfspvc.com/en/products/#${p.id}`,
    name: p.name,
  })),
};
---
<BaseLayout
  title="Foshan PVC Wire & Cable Compound Manufacturer - Xiangfa Shun Plastic"
  description="Foshan Sanshui Xiangfa Shun Plastic Co., Ltd. — PVC wire & cable compound manufacturer in Foshan, Guangdong. In-house formulation, mixing, extrusion, pelletizing, screening and packaging. Main products: 70℃ insulation, sheath, electronic wire, plug, 105℃ heat-resistant, -40℃ cold-resistant, high-transparent, matte, modified PVC compounds. Tel/WeChat 13450853338."
  locale="en"
  jsonLd={[websiteLd, productListLd]}
>
  <section class="hero">
    <img class="hero-media" src="/images/factory-pelletizing-workshop.jpg" alt="Pelletizing equipment area inside Xiangfa Shun's workshop" loading="eager" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">FOSHAN · PVC COMPOUND MANUFACTURER</p>
        <h1>Materials for the<br /><span>wire you make.</span></h1>
        <p class="hero-sub">PVC compounds for insulation, sheathing and molded cable components. Tell us your application, target standard and processing conditions so we can discuss a suitable formulation and sample trial.</p>
        <div class="hero-actions">
          <a href={`mailto:${siteConfig.email}`} class="btn btn-phone btn-lg">Email {siteConfig.email}</a>
          <a href="/en/products/" class="btn btn-light btn-lg">Explore compounds</a>
        </div>
      </div>
      <div class="hero-facts" aria-label="What to discuss with the factory">
        <div><span>01 / APPLICATION</span><strong>Wire & cable</strong></div>
        <div><span>02 / PROCESS</span><strong>Extrusion or molding</strong></div>
        <div><span>03 / NEXT STEP</span><strong>Sample validation</strong></div>
      </div>
    </div>
    <span class="hero-image-note">Our workshop · capture date unconfirmed</span>
  </section>

  <section class="trust-section">
    <div class="container">
      <div class="trust-bar">
        <span class="trust-item">In-house Formulation</span>
        <span class="trust-item">Own Production Line</span>
        <span class="trust-item">Batch Traceable</span>
        <span class="trust-item">Sample timing confirmed per request</span>
        <span class="trust-item">Sample-based Dev</span>
        <span class="trust-item">Factory Visit Welcome</span>
      </div>
    </div>
  </section>

  <section class="section-tight stats-section">
    <div class="container">
      <div class="stats-strip">
        <div class="stat-item">
          <div class="stat-value">9<span class="stat-unit">categories</span></div>
          <div class="stat-label">PVC Wire & Cable Compound</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">7<span class="stat-unit">steps</span></div>
          <div class="stat-label">Full Production Line</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">Trial</div>
          <div class="stat-label">Sampling plan confirmed together</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">Quote</div>
          <div class="stat-label">MOQ confirmed per formulation</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="PRODUCTS"
        title="Main Products"
        subtitle="Full range of PVC compounds for wire & cable, formula and color adjustable to customer specs"
      />

      <div class="grid grid-3 products-grid">
        {productOverview.map((p, i) => (
          <ProductCard
            id={p.id}
            name={p.name}
            category={p.category}
            icon={p.icon}
            description={p.description}
            highlights={p.highlights}
            href={`/en/products/#${p.id}`}
            index={i}
            locale="en"
          />
        ))}
      </div>

      <div class="see-more">
        <a href="/en/products/" class="btn btn-outline btn-lg">
          View full specs & inquiry guide
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="see-more-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionTitle
        eyebrow="PROCESS"
        title="Seven production steps, complete line"
        subtitle="In-house R&D · In-house extrusion · Batch-traceable"
      />

      <div class="process-rail">
        {processSteps.map((s, i) => (
          <div class="process-step" style={`--step-i:${i}`}>
            <div class="process-marker">
              <span class="process-no">{s.step}</span>
              {i < processSteps.length - 1 && <span class="process-line"></span>}
            </div>
            <div class="process-content">
              <h3>{s.label}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="see-more">
        <a href="/en/manufacturing/" class="btn btn-outline">
          See manufacturing details
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="see-more-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="ADVANTAGES"
        title="Why go factory-direct"
        subtitle="PVC wire & cable compound isn't a generic SKU — wrong specs cause downstream process issues"
      />

      <div class="grid grid-3">
        {advantages.map((a) => (
          <div class="advantage-card card">
            <div class="advantage-no">{a.icon}</div>
            <h3 class="advantage-title">{a.title}</h3>
            <p class="advantage-desc">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionTitle
        eyebrow="WHO WE SERVE"
        title="Who we work with"
        subtitle="PVC compound isn't generic — match formulation to structure and process"
      />

      <div class="customer-grid">
        {suitableCustomers.map((c) => (
          <div class="customer-card">
            <div class="customer-icon">{c.icon}</div>
            <div class="customer-label">{c.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section inquiry-section">
    <div class="container">
      <div class="cta-box inquiry-cta">
        <div class="inquiry-text">
          <div class="section-eyebrow inquiry-eyebrow">GET QUOTE</div>
          <h2>Need a sample or quote?</h2>
          <p>Email your application, target specification, volume and processing method. We will confirm a suitable product, trial scope and quotation with you.</p>
          <ul class="inquiry-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>Usage scenario (power cord jacket / UL wire / outdoor)</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>Key performance (temp / flame / cold / hardness / color)</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>Estimated monthly volume & MOQ</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>Processing (extrusion speed, die specs)</li>
          </ul>
        </div>
        <div class="inquiry-actions">
          <a href={`mailto:${siteConfig.email}`} class="btn btn-phone btn-lg">Email {siteConfig.email}</a>
          <a href="/en/contact/" class="btn btn-outline btn-lg">Full contact info</a>
          <div class="inquiry-note">Tel / WeChat: +86 134 5085 3338</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 700px;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: #162521;
    color: #fff;
  }
  .hero-media, .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-media { object-fit: cover; object-position: center; }
  .hero-shade {
    background:
      linear-gradient(90deg, rgba(9, 25, 22, .93) 0%, rgba(9, 25, 22, .76) 34%, rgba(9, 25, 22, .15) 82%),
      linear-gradient(0deg, rgba(9, 25, 22, .7), transparent 42%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 690px) minmax(240px, 320px);
    align-items: end;
    gap: var(--sp-7);
    padding-top: 160px;
    padding-bottom: 78px;
  }
  .hero-eyebrow {
    margin-bottom: var(--sp-4);
    color: #f7b07e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .14em;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(46px, 6vw, 78px);
    line-height: 1.04;
    letter-spacing: -.035em;
    margin-bottom: var(--sp-5);
  }
  .hero h1 span { color: #fff; }
  .hero-sub {
    max-width: 620px;
    color: rgba(255,255,255,.87);
    font-size: 19px;
    line-height: 1.65;
    margin-bottom: var(--sp-6);
  }
  .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }
  .hero-facts {
    display: grid;
    gap: 1px;
    border: 1px solid rgba(255,255,255,.26);
    background: rgba(255,255,255,.18);
  }
  .hero-facts div { padding: 18px 20px; background: rgba(9,25,22,.72); }
  .hero-facts span {
    display: block;
    color: #f7b07e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
    margin-bottom: 6px;
  }
  .hero-facts strong { color: #fff; font-size: 17px; }
  .hero-image-note {
    position: absolute;
    right: 18px;
    bottom: 14px;
    z-index: 2;
    padding: 5px 9px;
    color: #fff;
    background: rgba(8,18,17,.82);
    font-size: 12px;
  }

  .trust-section {
    background: var(--color-surface);
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-section {
    background: var(--color-bg);
  }

  .products-grid {
    margin-bottom: var(--sp-6);
  }

  .see-more {
    text-align: center;
    margin-top: var(--sp-6);
  }

  .see-more .btn {
    gap: 8px;
  }

  .see-more-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.2s var(--ease-out);
  }

  .see-more .btn:hover .see-more-icon {
    transform: translateX(4px);
  }

  .process-rail {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--sp-3);
    margin-bottom: var(--sp-7);
  }

  .process-step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .process-marker {
    position: relative;
    display: flex;
    align-items: center;
  }

  .process-no {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2px solid var(--color-primary);
    color: var(--color-primary-dark);
    font-weight: 800;
    font-size: var(--fs-base);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-feature-settings: 'tnum';
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  .process-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-accent) 100%);
    margin-left: -2px;
  }

  .process-content h3 {
    font-size: var(--fs-base);
    margin-bottom: 4px;
    color: var(--color-primary-dark);
  }

  .process-content p {
    font-size: var(--fs-sm);
    color: var(--color-text-soft);
    margin: 0;
    line-height: 1.6;
  }

  .advantage-card {
    padding: var(--sp-6);
    height: 100%;
    position: relative;
  }

  .advantage-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    border-radius: var(--radius-sm);
    font-size: var(--fs-lg);
    font-weight: 800;
    margin-bottom: var(--sp-4);
  }

  .advantage-title {
    font-size: var(--fs-md);
    color: var(--color-primary-dark);
    margin-bottom: var(--sp-3);
  }

  .advantage-desc {
    font-size: var(--fs-sm);
    color: var(--color-text-soft);
    margin: 0;
    line-height: 1.75;
  }

  .customer-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--sp-3);
  }

  .customer-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--sp-5) var(--sp-3);
    text-align: center;
    transition: all 0.25s var(--ease-out);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .customer-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-3px);
  }

  .customer-icon {
    font-size: 32px;
    color: var(--color-primary);
  }

  .customer-label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .inquiry-section {
    padding: var(--sp-8) 0;
  }

  .inquiry-cta {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-7);
    align-items: center;
  }

  .inquiry-eyebrow {
    color: var(--color-accent);
  }

  .inquiry-text h2 {
    color: #fff;
    font-size: var(--fs-2xl);
    margin-bottom: var(--sp-4);
  }

  .inquiry-text p {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-md);
    margin-bottom: var(--sp-5);
    line-height: 1.8;
  }

  .inquiry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-sm);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .inquiry-list li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .inquiry-list .check-icon {
    width: 18px;
    height: 18px;
    color: var(--color-accent);
    background: rgba(227, 99, 42, 0.15);
    border-radius: 50%;
    padding: 2px;
    flex-shrink: 0;
  }

  .inquiry-actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .inquiry-note {
    margin-top: var(--sp-2);
    padding-top: var(--sp-4);
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
  }

  @media (max-width: 1100px) {
    .process-rail {
      grid-template-columns: repeat(3, 1fr);
    }

    .process-step:nth-child(3) .process-line,
    .process-step:nth-child(6) .process-line {
      display: none;
    }

    .customer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero-inner, .inquiry-cta { grid-template-columns: 1fr; gap: var(--sp-6); }
    .hero-inner { padding-top: 110px; padding-bottom: 72px; }
    .hero-facts { grid-template-columns: repeat(3, 1fr); }
    .hero h1 { font-size: clamp(42px, 7vw, 64px); }

    .process-rail {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-step:nth-child(odd) .process-line {
      display: none;
    }

    .customer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .hero { min-height: 680px; }
    .hero-media { object-position: 58% center; }
    .hero-shade { background: linear-gradient(90deg, rgba(9,25,22,.9), rgba(9,25,22,.48)), linear-gradient(0deg, rgba(9,25,22,.8), transparent 65%); }
    .hero h1 { font-size: clamp(38px, 10vw, 52px); }
    .hero-sub { font-size: 16px; }
    .hero-facts { grid-template-columns: 1fr; }
    .hero-facts div { padding: 10px 14px; }
    .hero-image-note { left: 18px; right: auto; font-size: 10px; }

    .process-rail {
      grid-template-columns: 1fr;
    }

    .process-line {
      display: none !important;
    }

    .customer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
