---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  locale="en"
  title="Jobs"
  description="Recruitment information for Foshan Sanshui Xiangfa Shun Plastic Co., Ltd. Job requirements have not been published yet."
  breadcrumbs={[
    { name: 'Home', href: '/en/' },
    { name: 'Jobs', href: '/en/jobs/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Jobs',
    description: 'Recruitment information for Foshan Sanshui Xiangfa Shun Plastic Co., Ltd.',
  }}
>
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Jobs</span>
      </nav>
      <div class="section-eyebrow page-eyebrow">JOBS</div>
      <h1>Jobs</h1>
      <p class="page-header-sub">Job requirements have not been published yet.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="empty-state">
        <h2>Job Requirements</h2>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-eyebrow {
    margin-bottom: var(--sp-3);
  }

  .empty-state {
    min-height: 220px;
    padding: var(--sp-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .empty-state h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: var(--fs-xl);
  }
</style>
