---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutContent } from '../data/about';
import { siteConfig } from '../config/site';
import EvidenceGallery from '../components/EvidenceGallery.astro';
const t = aboutContent.zh;
---
<BaseLayout title={t.title} description={t.summary} breadcrumbs={[{ name: t.title, href: '/about/' }]} jsonLd={{ '@context': 'https://schema.org', '@type': 'AboutPage', name: t.title, description: t.summary, about: { '@id': `${siteConfig.url}/#organization` } }}>
  <section class="page-header"><div class="container"><div class="section-eyebrow page-eyebrow">ABOUT</div><h1>{t.title}</h1><p class="page-header-sub">{t.summary}</p></div></section>
  <section class="section"><div class="container"><div class="section-eyebrow">HOW WE WORK</div><div class="value-grid">{t.values.map(([title, body], i) => (<article><span>0{i + 1}</span><h2>{title}</h2><p>{body}</p></article>))}</div></div></section>
  <EvidenceGallery area="factory" /><section class="section"><div class="container company-facts"><h2>企业信息</h2><dl><div><dt>公司名称</dt><dd>{siteConfig.companyZh}</dd></div><div><dt>所在地区</dt><dd>{siteConfig.addressZh}</dd></div><div><dt>邮箱</dt><dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd></div><div><dt>电话 / 微信</dt><dd><a href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a></dd></div></dl><p>来厂前请联系确认详细地址与接待时间。具体产品文件在确认配方与可公开范围后提供。</p></div></section><section class="section section-alt"><div class="container trust-note"><p>公司文件、检测报告与证书仅在核实有效性和公开权限后发布。需要具体产品资料，请先说明用途和目标标准。</p><a class="btn btn-primary" href="/contact/">联系我们</a></div></section>
</BaseLayout>
<style>.page-eyebrow{margin-bottom:var(--sp-3)}.value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-5);margin-top:var(--sp-6)}.value-grid article{padding:var(--sp-6);border:1px solid var(--color-border);border-radius:var(--radius-md)}.value-grid span{color:var(--color-accent);font-weight:800}.trust-note{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-6)}@media(max-width:720px){.value-grid{grid-template-columns:1fr}.trust-note{align-items:flex-start;flex-direction:column}}.company-facts{max-width:900px}.company-facts h2{color:var(--color-primary-dark)}.company-facts dl div{display:grid;grid-template-columns:160px 1fr;gap:var(--sp-4);padding:var(--sp-3) 0;border-bottom:1px solid var(--color-border)}.company-facts dt{font-weight:700}.company-facts dd{margin:0;overflow-wrap:anywhere}@media(max-width:600px){.company-facts dl div{grid-template-columns:1fr;gap:2px}}</style>
