---
interface Props {
  id: string;
  name: string;
  category: string;
  summary: string;
  useCases: string[];
  suitableCustomers: string[];
  concerns: string[];
  inquiryNeeds: string[];
  index?: number;
  locale?: 'zh-CN' | 'en';
}

const {
  id,
  name,
  category,
  summary,
  useCases,
  suitableCustomers,
  concerns,
  inquiryNeeds,
  index = 0,
  locale = 'zh-CN',
} = Astro.props;
const isEn = locale === 'en';
const email = '17751261024@163.com';
---
<article class="product-detail" id={id} style={`--pd-i:${index}`}>
  <header class="product-detail-header">
    <div class="product-detail-meta">
      <span class="product-detail-no">{String(index + 1).padStart(2, '0')}</span>
      <span class="product-detail-cat">{category}</span>
    </div>
    <h3 class="product-detail-name">{name}</h3>
    <p class="product-detail-summary">{summary}</p>
  </header>

  <div class="product-detail-grid">
    <div class="product-detail-block">
      <h4>
        <span class="block-icon">◆</span>
        {isEn ? 'Typical applications' : '主要用途'}
      </h4>
      <ul>{useCases.map((u) => <li>{u}</li>)}</ul>
    </div>

    <div class="product-detail-block">
      <h4>
        <span class="block-icon">◆</span>
        {isEn ? 'Buyer types' : '适合客户'}
      </h4>
      <ul>{suitableCustomers.map((u) => <li>{u}</li>)}</ul>
    </div>

    <div class="product-detail-block">
      <h4>
        <span class="block-icon">◆</span>
        {isEn ? 'Processing details to confirm' : '需确认的加工条件'}
      </h4>
      <ul>{(isEn ? ['Extrusion or molding equipment', 'Temperature and line speed', 'Current sample and acceptance criteria'] : ['挤出或注塑设备', '温度与生产速度', '现用样品与验收条件']).map((u) => <li>{u}</li>)}</ul>
    </div>

    <div class="product-detail-block">
      <h4>
        <span class="block-icon">◆</span>
        {isEn ? 'Performance questions' : '常见关注指标'}
      </h4>
      <ul>{concerns.map((u) => <li>{u}</li>)}</ul>
    </div>
  </div>

  <div class="product-detail-specs">
    <h4>{isEn ? 'Specification and test confirmation' : '规格与测试确认'}</h4>
    <p>{isEn ? 'Target values, test methods and applicable standards depend on the formulation and end use. Ask for a product-specific technical sheet or agreed test report before placing an order.' : '目标数值、测试方法和适用标准取决于配方及最终用途。下单前请索取对应产品技术单，确认测试项目与验收条件。'}</p>
  </div>

  <div class="product-detail-inquiry">
    <div class="inquiry-content">
      <h4>{isEn ? 'Include with your inquiry' : '询价需提供'}</h4>
      <ol>{inquiryNeeds.map((u) => <li>{u}</li>)}</ol>
    </div>
    <a href={isEn ? `mailto:${email}` : `tel:13450853338`} class="btn btn-phone product-cta">
      <span>{isEn ? 'Email inquiry' : '立即咨询'}</span>
      <span class="cta-phone">{isEn ? email : '13450853338'}</span>
    </a>
  </div>
</article>

<style>
  .product-detail {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--sp-6) var(--sp-6);
    margin-bottom: var(--sp-6);
    scroll-margin-top: 100px;
    transition: box-shadow 0.28s var(--ease-out), border-color 0.28s var(--ease-out);
  }

  .product-detail:hover {
    box-shadow: var(--shadow-md);
    border-left-color: var(--color-accent);
  }

  .product-detail-header {
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: var(--sp-4);
    margin-bottom: var(--sp-5);
  }

  .product-detail-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .product-detail-no {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .product-detail-cat {
    font-size: var(--fs-xs);
    color: var(--color-primary);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-detail-name {
    font-size: var(--fs-xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--sp-3);
  }

  .product-detail-summary {
    font-size: var(--fs-base);
    color: var(--color-text-soft);
    margin: 0;
    line-height: 1.75;
  }

  .product-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-5);
    margin-bottom: var(--sp-5);
  }

  .product-detail-block h4 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-base);
    color: var(--color-primary-dark);
    margin-bottom: var(--sp-3);
    font-weight: 700;
  }

  .block-icon {
    color: var(--color-accent);
    font-size: 12px;
  }

  .product-detail-block ul {
    margin: 0;
    padding-left: 1.2em;
    color: var(--color-text-soft);
    font-size: var(--fs-sm);
    line-height: 1.85;
  }

  .product-detail-block li {
    margin-bottom: 4px;
  }

  .product-detail-specs {
    margin-bottom: var(--sp-5);
    background: var(--color-surface-alt);
    padding: var(--sp-5);
    border-radius: var(--radius-md);
  }

  .product-detail-specs h4 {
    font-size: var(--fs-base);
    color: var(--color-primary-dark);
    margin-bottom: var(--sp-3);
    font-weight: 700;
  }

  .product-detail-specs th {
    width: 30%;
    background: var(--color-surface);
  }

  .specs-note {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    margin: var(--sp-3) 0 0;
    font-style: italic;
  }

  .product-detail-inquiry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    background: linear-gradient(135deg, var(--color-primary-soft) 0%, #f7fbf8 100%);
    padding: var(--sp-5);
    border-radius: var(--radius-md);
    border: 1px solid #d3e2d8;
  }

  .inquiry-content h4 {
    font-size: var(--fs-base);
    color: var(--color-primary-dark);
    margin-bottom: var(--sp-3);
    font-weight: 700;
  }

  .inquiry-content ol {
    margin: 0;
    padding-left: 1.5em;
    color: var(--color-text-soft);
    font-size: var(--fs-sm);
    line-height: 1.85;
  }

  .inquiry-content li {
    margin-bottom: 2px;
  }

  .product-cta {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.2;
    padding: 14px 22px;
  }

  .cta-phone {
    font-size: 13px;
    opacity: 0.9;
    font-weight: 600;
    margin-top: 2px;
    font-feature-settings: 'tnum';
  }

  @media (max-width: 720px) {
    .product-detail {
      padding: var(--sp-4);
    }

    .product-detail-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }

    .product-detail-inquiry {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .inquiry-content ol {
      text-align: left;
    }
  }
</style>
