---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import EvidenceGallery from '../../components/EvidenceGallery.astro';

const phoneNumber = '13450853338';

const flow = [
  { step: '01', title: 'Formulation', desc: 'Customer provides usage scenario and performance specs. Engineers confirm details and propose initial formula.' },
  { step: '02', title: 'Sample Trial', desc: 'Agree on trial scope and timing. The buyer checks performance on its own extrusion or molding equipment.' },
  { step: '03', title: 'Raw Material Mixing', desc: 'Prepare and mix the materials required by the agreed formulation.' },
  { step: '04', title: 'Extrusion & Pelletizing', desc: 'Set the process for the formulation and produce pellets for the agreed product.' },
  { step: '05', title: 'Cooling & Screening', desc: 'Cool, cut and inspect pellets according to the production plan.' },
  { step: '06', title: 'Packaging & Delivery', desc: 'Confirm bag size, identification and shipping arrangements before the order.' },
  { step: '07', title: 'Order Records', desc: 'Agree on inspection, retained samples and batch documents for the specific order.' },
];

const capabilities = [
  { icon: '⚙', title: 'PVC Formulation R&D', desc: 'Standard PVC, modified PVC, flame-retardant, heat-resistant, cold-resistant — all customizable.' },
  { icon: '⊟', title: 'Raw Material Sourcing', desc: 'Confirm the required PVC resin and additives for each formulation and order.' },
  { icon: '◐', title: 'Mixing Process', desc: 'Materials are mixed according to the agreed process. Equipment details can be discussed during a factory visit.' },
  { icon: '⊕', title: 'Extrusion & Pelletizing', desc: 'Confirm equipment suitability, capacity and timing for the requested product before ordering.' },
  { icon: '◈', title: 'Cutting & Screening', desc: 'Pellet appearance and size requirements are confirmed for each product.' },
  { icon: '⊞', title: 'Packaging & Warehousing', desc: 'Confirm bag size, labeling and shipment preparation with your quotation.' },
];

const qualityItems = [
  'Specify the applicable standard and test methods before sampling',
  'Agree on acceptance values and documentation for each product',
  'Review pellet appearance and processing feedback during trials',
  'Confirm any batch records or retained samples in the purchase terms',
  'Discuss changes before repeat orders',
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Custom PVC Wire & Cable Compound Production Flow',
  description: 'Full 7-step process from requirement to delivery',
  step: flow.map((f, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: f.title,
    text: f.desc,
  })),
};
---
<BaseLayout
  title="Manufacturing Capability"
  description="Explore the PVC compound inquiry, sampling, production and delivery workflow. Equipment, testing and batch documentation are confirmed for each product and order."
  locale="en"
  breadcrumbs={[
    { name: 'Home', href: '/en/' },
    { name: 'Manufacturing', href: '/en/manufacturing/' },
  ]}
  jsonLd={howToLd}
>
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Manufacturing</span>
      </nav>
      <div class="section-eyebrow page-eyebrow">MANUFACTURING · 7 PROCESS STEPS</div>
      <h1>Manufacturing Capability</h1>
      <p class="page-header-sub">
        From application review to sampling and delivery, confirm each step for your product and order.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="PROCESS" title="Seven Production Steps" subtitle="Full chain from customer requirements to finished goods delivery" />
      <div class="flow-grid">
        {flow.map((item, i) => (
          <article class="flow-card" style={`--flow-i:${i}`}>
            <div class="flow-step">{item.step}</div>
            <h3 class="flow-title">{item.title}</h3>
            <p>{item.desc}</p>
            {i < flow.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionTitle eyebrow="BUYER GUIDE" title="From trial to repeat order" subtitle="Confirm the product and acceptance criteria before committing to volume" />
      <div class="grid grid-3">
        <article class="capability-card"><h3>1. Share requirements</h3><p>Send the cable application, target standard, processing equipment, color and expected monthly volume.</p></article>
        <article class="capability-card"><h3>2. Validate a sample</h3><p>Agree on trial quantity and checks. Record extrusion or molding results and any changes needed.</p></article>
        <article class="capability-card"><h3>3. Confirm an order</h3><p>Approve the specification, packaging, batch documents, lead time and payment terms in the quotation.</p></article>
      </div>
    </div>
  </section>
  <EvidenceGallery area="factory" locale="en" />
  <section class="section section-alt">
    <div class="container">
      <SectionTitle eyebrow="CAPABILITIES" title="Equipment & Process" subtitle="Ask for current equipment details and arrange a site visit when evaluating supply" />
      <div class="grid grid-3">
        {capabilities.map((c) => (
          <div class="capability-card">
            <div class="capability-icon" aria-hidden="true">{c.icon}</div>
            <h3 class="capability-title">{c.title}</h3>
            <p class="capability-desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EvidenceGallery area="quality" locale="en" />
  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="INTERNATIONAL INQUIRY" title="Packaging and export details to discuss" subtitle="Share your destination and required documents early so availability can be checked" />
      <div class="grid grid-3">
        <article class="capability-card"><h3>Packaging</h3><p>State preferred bag weight, pallet needs, label language and any storage requirements.</p></article>
        <article class="capability-card"><h3>Shipment</h3><p>Provide destination, desired shipment date and delivery terms for a tailored quotation.</p></article>
        <article class="capability-card"><h3>Documents</h3><p>List the technical sheet, test reports or customs documents you require. Availability and scope are confirmed before order.</p></article>
      </div>
      <p style="margin-top:var(--sp-5)"><a class="btn btn-phone" href="mailto:17751261024@163.com">Email procurement requirements</a></p>
    </div>
  </section>
      <SectionTitle eyebrow="QUALITY" title="Quality & Order Records" subtitle="Agree on testing, acceptance conditions and documentation before ordering" />
      <div class="quality-block">
        <ul class="quality-list">
          {qualityItems.map((q) => (
            <li>
              <span class="quality-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span>{q}</span>
            </li>
          ))}
        </ul>
        <div class="quality-cta">
          <h3>Welcome to visit our factory</h3>
          <p>Please call ahead to schedule a visit</p>
          <a href={`tel:${phoneNumber}`} class="btn btn-phone btn-lg">📞 Schedule Visit {phoneNumber}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-eyebrow { margin-bottom: var(--sp-3); }

  .flow-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    position: relative;
  }

  .flow-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--sp-5);
    position: relative;
    transition: all 0.28s var(--ease-out);
  }

  .flow-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .flow-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    font-weight: 800;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--sp-3);
    letter-spacing: 0.05em;
  }

  .flow-title { font-size: var(--fs-md); color: var(--color-primary-dark); margin-bottom: var(--sp-2); }
  .flow-card p { font-size: var(--fs-sm); color: var(--color-text-soft); margin: 0; line-height: 1.7; }

  .flow-arrow {
    position: absolute;
    right: -22px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-accent);
    font-size: 18px;
    font-weight: 700;
    z-index: 1;
  }

  .capability-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--sp-6);
    transition: all 0.28s var(--ease-out);
    height: 100%;
  }

  .capability-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .capability-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, var(--color-primary-soft) 0%, #d3e2d8 100%);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    font-size: 24px;
    margin-bottom: var(--sp-4);
  }

  .capability-title { font-size: var(--fs-md); color: var(--color-primary-dark); margin-bottom: var(--sp-3); }
  .capability-desc { font-size: var(--fs-sm); color: var(--color-text-soft); margin: 0; line-height: 1.75; }

  .quality-block {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-7);
    align-items: center;
    box-shadow: var(--shadow-sm);
  }

  .quality-list { list-style: none; padding: 0; margin: 0; }
  .quality-list li { display: flex; gap: var(--sp-3); padding: var(--sp-4) 0; border-bottom: 1px dashed var(--color-border); color: var(--color-text-soft); font-size: var(--fs-base); align-items: center; }
  .quality-list li:last-child { border-bottom: none; }

  .quality-check {
    width: 28px;
    height: 28px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .quality-check svg { width: 16px; height: 16px; }

  .quality-cta {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #fff;
    padding: var(--sp-6);
    border-radius: var(--radius-md);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .quality-cta::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(227, 99, 42, 0.4) 0%, transparent 70%);
    border-radius: 50%;
  }

  .quality-cta h3 { color: #fff; margin-bottom: var(--sp-2); font-size: var(--fs-lg); }
  .quality-cta p { color: rgba(255, 255, 255, 0.8); margin-bottom: var(--sp-4); font-size: var(--fs-sm); }

  @media (max-width: 1100px) {
    .flow-grid { grid-template-columns: repeat(2, 1fr); }
    .flow-card:nth-child(2) .flow-arrow,
    .flow-card:nth-child(4) .flow-arrow,
    .flow-card:nth-child(6) .flow-arrow { display: none; }
  }

  @media (max-width: 720px) {
    .flow-grid, .quality-block { grid-template-columns: 1fr; }
    .flow-arrow { display: none !important; }
  }
</style>
