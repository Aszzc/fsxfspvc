---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout locale="en" title="Page not found" description="The requested page could not be found." noindex>
  <section class="section">
    <div class="container not-found">
      <div class="section-eyebrow">404</div>
      <h1>Page not found</h1>
      <p>The link may have changed. Return to the homepage, browse products or contact us.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/en/">Home</a>
        <a class="btn btn-outline" href="/en/products/">Products</a>
        <a class="btn btn-outline" href="/en/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found { max-width: 720px; text-align: center; padding-top: var(--sp-8); padding-bottom: var(--sp-8); }
  .not-found h1 { margin: var(--sp-3) 0; }
  .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--sp-3); }
</style>
