---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutContent } from '../../data/about';
import { siteConfig } from '../../config/site';
import EvidenceGallery from '../../components/EvidenceGallery.astro';
const t = aboutContent.en;
---
<BaseLayout
  locale="en"
  title={t.title}
  description={t.summary}
  breadcrumbs={[{ name: 'Home', href: '/en/' }, { name: t.title, href: '/en/about/' }]}
  jsonLd={{ '@context': 'https://schema.org', '@type': 'AboutPage', name: t.title, description: t.summary, about: { '@id': `${siteConfig.url}/#organization` } }}
>
  <section class="page-header">
    <div class="container">
      <div class="section-eyebrow page-eyebrow">ABOUT</div>
      <h1>{t.title}</h1>
      <p class="page-header-sub">{t.summary}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">HOW WE WORK</div>
      <h2>From requirement to repeatable supply</h2>
      <div class="value-grid">
        {t.values.map(([title, body], i) => (
          <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
    </div>
  </section>
  <EvidenceGallery area="factory" locale="en" />
  <section class="section">
    <div class="container company-facts">
      <h2>Company details</h2>
      <dl>
        <div><dt>Company</dt><dd>{siteConfig.companyEn}</dd></div>
        <div><dt>Location</dt><dd>{siteConfig.addressEn}</dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd></div>
        <div><dt>Phone</dt><dd><a href={`tel:${siteConfig.phoneInternational}`}>{siteConfig.phoneInternational}</a></dd></div>
        <div><dt>WeChat</dt><dd>{siteConfig.wechat}</dd></div>
      </dl>
      <p>Please contact us to arrange a factory visit or discuss product information.</p>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container trust-note">
      <div><h2>Discuss your requirements with us</h2><p>Contact our team for product information and application support.</p></div>
      <a class="btn btn-primary" href="/en/contact/">Contact us</a>
    </div>
  </section>
</BaseLayout>
<style>
  .page-eyebrow{margin-bottom:var(--sp-3)}.value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-5);margin-top:var(--sp-6)}.value-grid article{padding:var(--sp-6);border:1px solid var(--color-border);border-radius:var(--radius-md)}.value-grid span{color:var(--color-accent);font-weight:800}.trust-note{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-6)}@media(max-width:720px){.value-grid{grid-template-columns:1fr}.trust-note{align-items:flex-start;flex-direction:column}}
  .company-facts { max-width: 900px; }
  .company-facts h2 { color: var(--color-primary-dark); }
  .company-facts dl { margin: 0 0 var(--sp-5); }
  .company-facts dl div { display: grid; grid-template-columns: 180px 1fr; gap: var(--sp-4); padding: var(--sp-3) 0; border-bottom: 1px solid var(--color-border); }
  .company-facts dt { font-weight: 700; }
  .company-facts dd { margin: 0; overflow-wrap: anywhere; }
  @media(max-width:600px) { .company-facts dl div { grid-template-columns: 1fr; gap: 2px; } }
</style>
